{
  "datasets": [
    {
      "name": "kpi",
      "displayName": "List headline numbers",
      "queryLines": [
        "SELECT count(*) AS members,\n",
        " sum(CAST(in_top_10pct AS INT)) AS calls_on_list,\n",
        " round(sum(CASE WHEN in_top_10pct THEN expected_value_at_risk END)) AS value_at_risk_on_list,\n",
        " round(sum(CASE WHEN in_top_10pct THEN churn_probability END)) AS expected_churners_on_list,\n",
        " sum(CASE WHEN in_top_10pct AND actual_churned THEN 1 ELSE 0 END) AS realised_churners_on_list\n",
        "FROM workspace.churn.scores_march_2017"
      ]
    },
    {
      "name": "risk",
      "displayName": "Risk mix",
      "queryLines": [
        "SELECT risk_level, count(*) AS members, sum(CAST(in_top_10pct AS INT)) AS on_list FROM workspace.churn.scores_march_2017 GROUP BY risk_level"
      ]
    },
    {
      "name": "top",
      "displayName": "Top of the call list",
      "queryLines": [
        "SELECT call_priority_rank AS rank, left(member_id, 10) AS member, risk_level,\n",
        " round(churn_probability, 3) AS churn_probability, round(member_value) AS member_value,\n",
        " round(expected_value_at_risk) AS value_at_risk, expiry_date\n",
        "FROM workspace.churn.scores_march_2017 WHERE call_priority_rank <= 25 ORDER BY call_priority_rank"
      ]
    },
    {
      "name": "drift",
      "displayName": "Drift (PSI)",
      "queryLines": [
        "SELECT feature, psi, band FROM workspace.churn.drift_psi ORDER BY psi DESC"
      ]
    },
    {
      "name": "alerts",
      "displayName": "Drift alerts",
      "queryLines": [
        "SELECT count_if(band = 'alert' AND feature <> 'score (calibrated)') AS alerts, max(CASE WHEN feature = 'score (calibrated)' THEN psi END) AS score_psi FROM workspace.churn.drift_psi"
      ]
    }
  ],
